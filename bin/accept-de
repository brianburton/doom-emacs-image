#!/usr/bin/env bash

set -euo pipefail

accept_file=.edit_accept
reject_file=.edit_reject

accept_dir() {
    dir="$1"

    if [[ ! -d "$dir" ]] ; then
      echo error: $dir is not a directory 1>&2
      exit 1
    fi

    if [[ -f "$dir/$reject_file" ]] ; then
      echo error: $dir contains $reject_file 1>&2
      exit 1
    fi

    if [[ ! -f "$dir/$accept_file" ]] ; then
      echo allow de to edit this directory > "$dir/$accept_file"
      echo created "$dir/$accept_file"
    fi
}

if [[ $# -lt 1 ]] ; then
  accept_dir .
else
  for d in "$@" ; do
    accept_dir "$d"
  done
fi
